[sub_resource type="GDScript" id="GDScript_puerta"]
script/source = "extends AnimatableBody3D

var is_open: bool = false
var is_moving: bool = false

func interact(player: Node3D) -> void:
	if is_moving:
		return
	is_moving = true
	var tween = create_tween()
	if is_open:
		tween.tween_property(self, \"rotation_degrees:y\", 0.0, 0.4)
	else:
		tween.tween_property(self, \"rotation_degrees:y\", -90.0, 0.4)
	is_open = not is_open
	tween.tween_callback(func(): is_moving = false)
"


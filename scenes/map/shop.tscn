[sub_resource type="GDScript" id="GDScript_persiana"]
script/source = "extends Node3D

var is_open: bool = true

func toggle() -> void:
	if is_open:
		close()
	else:
		open()

func open() -> void:
	is_open = true
	var tween = create_tween()
	tween.tween_property(self, \"position:y\", 1.35, 0.5)

func close() -> void:
	is_open = false
	var tween = create_tween()
	tween.tween_property(self, \"position:y\", 0.0, 0.5)
	
	var npcs = get_tree().get_nodes_in_group(\"npcs\")
	for npc in npcs:
		var can_react: bool = false
		if npc.has_method(\"can_react_to_persiana\"):
			can_react = npc.can_react_to_persiana()
		else:
			can_react = npc.is_at_counter
		
		if can_react:
			if npc.has_method(\"on_persiana_closed\"):
				npc.on_persiana_closed()
			elif npc.has_method(\"_timeout\"):
				npc._timeout()
"

[sub_resource type="GDScript" id="GDScript_boton"]
script/source = "extends StaticBody3D

@onready var persiana = $\"../Persiana\"
@onready var mesh = $Mesh

var mat: StandardMaterial3D

func _ready() -> void:
	mat = StandardMaterial3D.new()
	mat.albedo_color = Color(0.1, 0.8, 0.1)
	mesh.material = mat

func interact(player: Node3D) -> void:
	if persiana:
		persiana.toggle()
		if persiana.is_open:
			mat.albedo_color = Color(0.1, 0.8, 0.1)
		else:
			mat.albedo_color = Color(0.8, 0.1, 0.1)
"

